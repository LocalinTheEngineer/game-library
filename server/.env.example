# Bu dosyayı .env olarak kopyalayıp kendi bilgilerini yaz.
DATABASE_URL=postgresql://postgres:SIFREN@localhost:5432/game_library
PORT=4000

# rawg.io/apidocs adresinden ücretsiz alınır.
RAWG_API_KEY=

# Oturum jetonlarını imzalar. Uzun ve rastgele olmalı:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Yayında arayüzün adresi. Yerelde boş bırakılabilir.
CORS_ORIGINS=
